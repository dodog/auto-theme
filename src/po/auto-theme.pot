msgid "• GTK3 — older-style apps (Firefox, GIMP, many utilities)."
msgstr ""

#: ../prefs.js:91
msgid ""
"• GTK4 / libadwaita — Files, Settings, Extensions, Tweaks and newer apps; "
"only follows light/dark automatically, styled via a CSS override."
msgstr ""

#: ../prefs.js:92
msgid "• Shell — the top bar and overview, separate from all app windows."
msgstr ""

#: ../prefs.js:93
msgid ""
"• Qt5/Qt6 apps — separate settings system entirely; optional support via "
"qt5ct/qt6ct further down."
msgstr ""

#: ../prefs.js:94
msgid "• Flatpak apps — usually follow along automatically already."
msgstr ""

